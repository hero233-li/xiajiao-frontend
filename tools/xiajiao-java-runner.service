[Unit]
Description=xiajiao Java runner (compile + Xvfb screenshot)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/projects/xiajao/java-runner
Environment=JAVA_RUNNER_TOKEN=92a52e8b84cbcea6424dd7d50e0d6105116e99eeaf19f184
Environment=JAVA_RUNNER_BIND=172.18.0.1
Environment=JAVA_RUNNER_PORT=18791
ExecStart=/usr/bin/python3 /opt/projects/xiajao/java-runner/runner.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
