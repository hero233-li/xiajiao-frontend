{
  "manifest_version": 3,
  "name": "知途打印助手",
  "description": "将你在知途选择的PDF同步到上海图书馆文印网站，登录信息保留在浏览器中。",
  "version": "1.0.4",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://selfcopying.cnbksy.com/*",
    "https://xiajiao.cloud/*",
    "http://124.222.151.76:8080/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://xiajiao.cloud/*",
        "http://124.222.151.76:8080/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "bridge.js"
      ]
    },
    {
      "matches": [
        "https://selfcopying.cnbksy.com/client/new/cprintPc/*"
      ],
      "js": [
        "library.js"
      ]
    }
  ]
}
